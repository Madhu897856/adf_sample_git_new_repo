							}
						],
						"outputs": [
							{
								"referenceName": "ds_target_copy_latestfile",
								"type": "DatasetReference",
								"parameters": {}
							}
						]
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"variables": {
					"latest_file_name": {
						"type": "String"
					},
					"last_modified_time": {
