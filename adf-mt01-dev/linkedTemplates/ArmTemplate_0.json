							"scripts": [
								{
									"type": "Query",
									"text": "PRINT 'oepn the slect statements '\nselect * from employee\nPRINT 'end the slect statements '"
								},
								{
									"type": "NonQuery",
									"text": "create table c1(cid int,caname varchar(10));"
								},
								{
									"type": "Query",
									"text": "select * from Orders where OrderID=1006;"
								}
							],
